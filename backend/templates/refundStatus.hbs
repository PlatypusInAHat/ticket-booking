<!doctype html>
<html lang="en">
  <body style="margin:0;background:#f5f5f4;font-family:Arial,sans-serif;color:#1c1917">
    <div style="max-width:600px;margin:32px auto;background:#ffffff;border-radius:16px;padding:32px">
      <p style="font-size:13px;font-weight:700;color:#b45309;text-transform:uppercase">TicketStage refund update</p>
      <h1 style="font-size:26px;margin:12px 0">Hello {{userName}},</h1>
      <p style="line-height:1.6">{{statusMessage}}</p>
      <div style="margin:24px 0;padding:16px;background:#fafaf9;border-radius:12px">
        <p style="margin:0 0 8px"><strong>Booking:</strong> {{bookingNumber}}</p>
        <p style="margin:0 0 8px"><strong>Status:</strong> {{status}}</p>
        <p style="margin:0"><strong>Amount:</strong> {{amount}}</p>
      </div>
      <p style="font-size:13px;color:#78716c">Keep this email for your records.</p>
    </div>
  </body>
</html>
